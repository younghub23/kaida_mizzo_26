# Tala — environment variables
# Copy to .env.local for local dev, and set the same values as secrets on the
# Cloudflare worker (kaidamizzo26) for production.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=https://kaida1.ycatesting.com

# --- AI (Claude) ---
ANTHROPIC_API_KEY=

# --- Payments (Stripe) ---
# Use a test key (sk_test_...) with test-mode price IDs, or a live key
# (sk_live_...) with live-mode price IDs. The key and price IDs must be in the
# SAME mode or checkout will fail.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signing secret (whsec_...) for the Stripe webhook endpoint
# (<NEXT_PUBLIC_APP_URL>/api/webhooks/stripe). Required to verify events;
# must match the endpoint's mode (test vs live).
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs (price_..., NOT product prod_... IDs) — one per plan.
# Missing/invalid values cause the /plan page to return "Invalid price".
STRIPE_STARTER_PRICE_ID=   # Starter — $29/mo
STRIPE_PRICE_ID=           # Growth  — $99/mo
STRIPE_PRO_PRICE_ID=       # Pro     — $299/mo
STRIPE_AGENCY_PRICE_ID=    # Agency  — $599/mo

# --- Social ---
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Snapchat (Snap Marketing API) OAuth 2.0 — for connecting a Snapchat Business
# account. Create an OAuth app under a Snap Business account at
# business.snapchat.com (Business Details → OAuth apps). Scope:
# snapchat-marketing-api. Authorized redirect URI:
# <NEXT_PUBLIC_APP_URL>/api/social/snapchat/callback
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
# X (Twitter) OAuth 2.0 — for posting to X. Create an app in the X Developer
# Portal with OAuth 2.0 enabled, type "Web App" (confidential client), and
# "Read and write" permissions. Authorized redirect / callback URI:
# <NEXT_PUBLIC_APP_URL>/api/social/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# Google Analytics 4 (OAuth) — for the /analytics ROI/traffic data.
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/social/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Analytics ---
# Google Analytics 4 measurement ID (G-XXXXXXXXXX) for the site-wide gtag.js
# tag in app/layout.tsx. Optional — defaults to the live site's ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Force mock analytics on/off. Defaults: mock in dev, real-only in production.
# Set to 'true' to demo mock data on a deployed site, or 'false' to force
# real-only locally.
NEXT_PUBLIC_ANALYTICS_ALLOW_MOCK=

# --- Email ---
RESEND_API_KEY=
# Verified Resend sender that campaign emails are sent "from",
# e.g. "Tala <hello@yourdomain.com>". Required for the Socials > Emails
# "Send now" action; drafting/scheduling works without it.
EMAIL_FROM=
