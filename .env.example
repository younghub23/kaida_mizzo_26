# Tala — environment variables
# Copy to .env.local for local dev, and set the same values as secrets on the
# Cloudflare worker (kaidamizzo26) for production.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=https://kaida1.ycatesting.com

# --- AI (Claude) ---
ANTHROPIC_API_KEY=

# --- Payments (Stripe) ---
# Use a test key (sk_test_...) with test-mode price IDs, or a live key
# (sk_live_...) with live-mode price IDs. The key and price IDs must be in the
# SAME mode or checkout will fail.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe price IDs (price_..., NOT product prod_... IDs) — one per plan.
# Missing/invalid values cause the /plan page to return "Invalid price".
STRIPE_STARTER_PRICE_ID=   # Starter — $29/mo
STRIPE_PRICE_ID=           # Growth  — $99/mo
STRIPE_PRO_PRICE_ID=       # Pro     — $299/mo
STRIPE_AGENCY_PRICE_ID=    # Agency  — $599/mo

# --- Social ---
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Email ---
RESEND_API_KEY=

# --- Cron ---
# Shared secret protecting the scheduled-post publisher endpoints
# (/api/social/publish-due and /api/social/publish). The Cloudflare Cron
# Trigger (worker.ts) sends this as a Bearer token. Strongly recommended in
# production: set the SAME value as a secret on the kaidamizzo26 worker
# (`npx wrangler secret put CRON_SECRET`). If unset, the endpoints are open.
CRON_SECRET=
